CONFIG_ARCH_SONY_GANGES=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y
CONFIG_PSTORE=y
CONFIG_QCA_CLD_WLAN=y
# CONFIG_SMB1351_USB_CHARGER is not set
# CONFIG_SMB138X_CHARGER is not set
# CONFIG_MACH_SONY_DISCOVERY is not set
# CONFIG_MACH_SONY_DISCOVERY_DSDS is not set
# CONFIG_MACH_SONY_KIRIN is not set
# CONFIG_MACH_SONY_KIRIN_DSDS is not set
# CONFIG_MACH_SONY_MERMAID is not set
# CONFIG_MACH_SONY_MERMAID_DSDS is not set
# CONFIG_MACH_SONY_PIONEER is not set
# CONFIG_MACH_SONY_PIONEER_DSDS is not set
# CONFIG_MACH_SONY_VOYAGER is not set
# CONFIG_MACH_SONY_VOYAGER_DSDS is not set
# CONFIG_PSTORE_842_COMPRESS is not set
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_COMPRESS_DEFAULT="deflate"
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y
CONFIG_PSTORE_DEFLATE_COMPRESS_DEFAULT=y
# CONFIG_PSTORE_LZ4HC_COMPRESS is not set
# CONFIG_PSTORE_LZ4_COMPRESS is not set
# CONFIG_PSTORE_LZO_COMPRESS is not set
# CONFIG_PSTORE_PMSG is not set
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_ZSTD_COMPRESS is not set
CONFIG_QCA_CLD_WLAN_PROFILE="default"
CONFIG_REED_SOLOMON_ENC8=y
